# Change these before exposing the stack beyond localhost.
MYSQL_ROOT_PASSWORD=localrag-root-change-me
MYSQL_PASSWORD=localrag-change-me
POSTGRES_PASSWORD=localrag-change-me
MINIO_ROOT_USER=localrag
MINIO_ROOT_PASSWORD=localrag-change-me
MINERU_MODEL_SOURCE=modelscope
JWT_SECRET=replace-with-at-least-32-random-characters

# Supabase handles authentication only. Business data remains local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# Ollama always runs on the host. Docker rag-api uses host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3:14b
FALLBACK_CHAT_MODEL=qwen3:8b
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=qllama/bge-reranker-v2-m3

# Python RAG service and retrieval policy.
RAG_HOST=127.0.0.1
RAG_PORT=8001
RETRIEVAL_STRATEGY=vector
RETRIEVAL_TOP_K=12
RETRIEVAL_SCORE_THRESHOLD=0.35
CONTEXT_MAX_CHARS=12000
MAX_UPLOAD_MB=50
